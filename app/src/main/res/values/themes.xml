<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Ubah parent menjadi NoActionBar -->
    <style name="Theme.AmbulanceSmartTracker" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Terapkan warna primary -->
        <item name="colorPrimary">@color/navy_primary</item>
        <item name="colorSecondary">@color/orange_accent</item>

        <!-- Ubah warna status bar (jam dan baterai di atas HP) menjadi transparan/putih -->
        <item name="android:statusBarColor">@color/bg_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>